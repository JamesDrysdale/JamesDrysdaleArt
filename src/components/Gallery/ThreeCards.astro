---
/**
 * * This is a component that highlights three specific collections
 * Larger on the left, smaller two on the right
 */

import Button from "@components/Button/Button.astro";
import GalleryCard from "@components/GalleryCard/GalleryCard.astro";
import { getCollection } from "astro:content";

// Fetch all collections
const collections = await getCollection("collections");

// Sort collections by date (newest first)
const sortedCollections = collections.sort((a, b) => {
	if (a.data.date > b.data.date) {
		return -1;
	}
	if (a.data.date < b.data.date) {
		return 1;
	}
	return 0;
});

// Get the three newest collections
const newestCollections = sortedCollections.slice(0, 3);
---

<section id="highlights" class="site-container mt-12 scroll-mt-10 py-8 md:py-12">
	<div class="mx-auto max-w-6xl text-center">
		<h2 class="h2 text-pretty uppercase">Discover the newest collections of artwork.</h2>
	</div>
	<div class="grid gap-10 pt-8 md:grid-cols-2 md:pt-12">
		<div class="md:bg-base-100 md:rounded-md md:p-10 md:pb-6">
			<GalleryCard collection={newestCollections[0]} />
		</div>
		<div class="flex h-full flex-col justify-between gap-y-6">
			<GalleryCard collection={newestCollections[1]} />
			<hr class="border-base-100 hidden border md:block" />
			<GalleryCard collection={newestCollections[2]} />
		</div>
	</div>

	<div class="mt-12 flex justify-center">
		<Button href="/collections" variant="outline">View all collections</Button>
	</div>
</section>
