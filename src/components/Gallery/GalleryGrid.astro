---
import GalleryCard from "@components/GalleryCard/GalleryCard.astro";
import { type CollectionEntry, getCollection } from "astro:content";

interface Props {
	collections: CollectionEntry<"collections">[]; // Updated to use "collections"
	noTransitions?: boolean;
}

const { collections, noTransitions = false } = Astro.props as Props;
---

<div class="grid gap-x-4 gap-y-10 pt-8 md:grid-cols-3 md:pt-12">
	{
		collections && collections.length > 0 ? (
			collections.map((collection) => <GalleryCard collection={collection} />)
		) : (
			<p>No collections available. Please check back later.</p>
		)
	}
</div>
