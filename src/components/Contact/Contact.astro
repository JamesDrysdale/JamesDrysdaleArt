---
/**
 * * Contact section for the website
 */

import ContactForm from "@components/Forms/ContactForm.astro";
import { Image } from "astro:assets";

interface Props {
	class?: string;
}

const { class: className } = Astro.props as Props;

import contactImage from "@assets/images/Woodland-Thicket.jpg";
---

<section
	id='contact'
	class='mx-auto max-w-md scroll-mt-10 px-4 py-8 md:max-w-6xl md:py-12'
	class:list={[className]}
>
	<h2 class='h2 md:px-12 lg:text-6xl'>Start a conversation</h2>
	<div class='grid gap-y-10 md:grid-cols-2'>
		<div class='border-primary-300 mt-8 md:border-r md:pr-20 md:pl-12'>
			<p class='description text-lg'>
				Thinking about commissioning a painting, interested in an original, or simply have a
				question? Tell me a little about what you have in mind and I’ll get back to you within 1–2
				working days.
			</p>
			<div class='mx-auto mt-8 aspect-square overflow-hidden'>
				<Image
					src={contactImage}
					alt='Example of a woodland study painted by James Drysdale'
					width={450}
					densities={[1.5, 2]}
					class='h-full w-full object-cover'
				/>
			</div>
		</div>
		<div class='md:pr-12 md:pl-20'>
			<ContactForm />
		</div>
	</div>
</section>
