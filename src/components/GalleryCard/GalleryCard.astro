---
/**
 * GalleryCard component for displaying a single collection.
 * Props:
 * - collection: The collection data (title, description, thumbnail, slug).
 */

import Button from "@components/Button/Button.astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

// Define props
interface Props {
	collection: CollectionEntry<"collections">; // Collection data
}

// Destructure props
const { collection } = Astro.props as Props;
const { title, description, thumbnail } = collection.data; // Extract collection data
---

{
	collection ? (
		<div class="grid gap-4">
			<a href={`/collections/${collection.slug}`} class="aspect-square overflow-hidden">
				<Image
					src={thumbnail}
					alt={title}
					width={450}
					densities={[1.5, 2, 3]}
					class="h-auto min-h-full w-full min-w-full object-cover"
				/>
			</a>
			<div>
				<h3 class="text-lg font-bold">{title}</h3>
				<p class="text-sm text-gray-600">{description}</p>
				<Button href={`/collections/${collection.slug}`} class="mt-4">
					{" "}
					View Collection{" "}
				</Button>
			</div>
		</div>
	) : (
		<p>Collection data is missing.</p>
	)
}
