---
/**
 * * About section
 */

import profileImage from "@assets/images/James-Carbridge-Woods.jpg";
import { Image } from "astro:assets";
---

<section id='about' class='site-container scroll-mt-10 py-8 md:py-12'>
	<div class='flex flex-col md:flex-row'>
		<div class='md:w-2/3'>
			<h2 class='h3 text-primary-500 text-pretty uppercase'>Meet the artist</h2>
			<h3 class='h2 mt-4'>James Drysdale</h3>
			<div class='bg-base-100 mt-8 p-8 md:mb-20 lg:text-lg'>
				<p>
					I’m drawn to the moments in nature that make you stop and look twice: a shift in the
					light, the character of an animal, the atmosphere of a familiar place. I paint to hold
					onto those moments and give them a life beyond the instant they were first seen. Each
					painting is an invitation to keep a lasting connection to something you love, remember, or
					simply never want to lose sight of.
				</p>
				<div class='flex w-3/4 justify-end'>
					<p class='font-heading-1 text-3xl italic'>- James</p>
				</div>
			</div>
		</div>
		<div class='mr-auto max-w-md md:w-1/3 md:max-w-none'>
			<div class='my-auto aspect-[3/4] w-full overflow-hidden'>
				<Image
					src={profileImage}
					alt='Jenna Marie'
					width={450}
					densities={[1.5, 2]}
					class='h-auto min-h-full w-full min-w-full object-cover'
				/>
			</div>
		</div>
	</div>
</section>
